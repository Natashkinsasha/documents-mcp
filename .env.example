DOCS_ROOT=/absolute/path/to/documents
# Generate with: openssl rand -hex 32
MCP_TOKEN=
PORT=3000
HOST=127.0.0.1
INDEX_DIR=./data
OCR_LANGS=rus+bel+eng
RESCAN_MINUTES=10
MAX_FILE_MB=100
OCR_MAX_PAGES=300
IGNORE=**/archive/**,**/*.bak
TUNNEL_TOKEN=
PUBLIC_URL=
# Optional opt-out: READ_ONLY=1 hides all write/trash tools.
# READ_ONLY=1

# Docker Compose only; do not set DOCS_ROOT or INDEX_DIR in the container.
DOCS_PATH=/absolute/path/to/documents
