{
  "name": "documents-mcp",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "tsc && node scripts/build-binary.mjs --runtime-only",
    "build:binary": "node scripts/build-binary.mjs",
    "start": "node dist/main.js",
    "dev": "node scripts/prepare-runtime.mjs && tsx src/main.ts",
    "test": "node scripts/prepare-runtime.mjs && tsx --test --test-concurrency=2 test/*.test.ts",
    "sample": "tsx scripts/sample.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tesseract.js-data/bel": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "docx": "^9.15.3",
    "fflate": "^0.8.3",
    "htmlparser2": "^10.1.0",
    "mammoth": "^1.13.0",
    "picomatch": "^4.0.3",
    "pngjs": "7.0.0",
    "snowball-stemmers": "^0.6.0",
    "tesseract.js": "6.0.1",
    "unpdf": "2.1.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jsquash/webp": "1.5.0",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.2",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.27.0",
    "jpeg-js": "0.4.4",
    "opentype.js": "1.3.4",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
